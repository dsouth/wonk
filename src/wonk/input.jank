(ns wonk.input
  (:require [wonk.state :as state])
  (:include "extern.hpp"
            "callbacks.h"
            "xkbcommon/xkbcommon-keysyms.h"
            "xkbcommon/xkbcommon.h"
            "unistd.h"))

(defn spawn-command [cmd]
  (println "spawning command" cmd)
  (if (= (cpp/fork) 0)
    (do
      (cpp/setsid)
      (cpp/execl (cpp/cast (:* char) "/bin/sh")
                 (cpp/cast (:* char) "/bin/sh")
                 (cpp/cast (:* char) "-c")
                 (cpp/cast (:* char) cmd) 
                 cpp/nullptr))))

(defn is-target-in-vec? [target array length index]
  (let [unboxed-target (cpp/unbox (:* wl_listener) target)]
    (if (= length index)
      false
      (if (cpp/== unboxed-target (cpp/get_listener_pointer_at_index 
                              (cpp/unbox (:* (:* wl_listener)) array) index))
        true
        (recur target array length (inc index))))))

;; for each map in the keyboard array, pass in the listeners arry and length
;; TODO better way to get the listeners?!?!
(defn get-keyboard-map [target m v]
  (if (nil? m)
    nil
    (let [ls (cpp/unbox (:* array_of_listeners) (:listeners m))
          length (.-length ls)
          array (cpp/box (.-the_listeners ls))]
      ;; use some? instead?
      (if (is-target-in-vec? target array length 0)
        m
        (let [head (first v)
              tail (rest v)]
          (recur target head tail))))))

(defn modifier-press [e]
  (comment this might not have been compiling... :/
  (let [event (cpp/unbox (:* wlr_keyboard_key_event) e)
        keycode (+ (.-keycode event) 8)
        syms (#cpp (:* xkb_keysym_t))]
    (println "modifier press!")))
  (println "modifier pressed!"))

(defn key-press-modal [event sym-size syms]
  (if (cpp/== (.-state (cpp/unbox (:* wlr_keyboard_key_event) event)) 
              cpp/WL_KEYBOARD_KEY_STATE_PRESSED)
    (loop [index 0]
      (let [key-sym (cpp/get_sym_at_index
                      (cpp/unbox (:* (:const xkb_keysym_t)) syms) index)]
        (cond 
          (cpp/== cpp/XKB_KEY_Escape key-sym)
            (cpp/wl_display_terminate (cpp/unbox (:* wl_display) (:display @state/wm)))
          (cpp/== cpp/XKB_KEY_Return key-sym)
            (do
              (println "attempt to spawn...")
              (spawn-command "foot")
              )
          :else nil))
        (if (< sym-size index)
          (recur (inc index))))))

(defn key-press [e l]
  (let [event (cpp/unbox (:* wlr_keyboard_key_event) e)        
        keycode (+ (.-keycode event) 8)
        syms (#cpp (:* (:const xkb_keysym_t)))
        keyboard-state-list @(:keyboards @state/wm)
        keyboard-state (get-keyboard-map 
                         l
                         (first keyboard-state-list)
                         (rest keyboard-state-list))
        ]
    (if (not (nil? keyboard-state))
      (let [wlr-keyboard (cpp/unbox (:* wlr_keyboard) (:wlr-reference keyboard-state))
            xkb-state (.-xkb_state wlr-keyboard)
            sym-size (cpp/xkb_state_key_get_syms 
                       xkb-state
                       keycode 
                       (cpp/& syms))
            ]
        (key-press-modal e sym-size (cpp/box syms))))
    (println "key press!")))

(defn new-keyboard [d]
  (let [device (cpp/unbox (:* wlr_input_device) d)
        wlr_keyboard (cpp/wlr_keyboard_from_input_device device)
        context (cpp/xkb_context_new cpp/XKB_CONTEXT_NO_FLAGS)
        keymap (cpp/xkb_keymap_new_from_names 
                 context cpp/nullptr cpp/XKB_KEYMAP_COMPILE_NO_FLAGS)
        ]
    (if (not (cpp/wlr_keyboard_set_keymap wlr_keyboard keymap))
      ;; should log error here TODO hook up wlr logging
      (println "FAILED to set keymap"))
    (cpp/xkb_keymap_unref keymap)
    (cpp/xkb_context_unref context)
    (let [rate-hz 25
          delay-ms 600]
      (cpp/wlr_keyboard_set_repeat_info wlr_keyboard rate-hz delay-ms))
    (let [ls (cpp/wire_keyboard_listeners device wlr_keyboard)]
      (swap! (:keyboards @state/wm) conj {:wlr-reference (cpp/box wlr_keyboard)
                                          :listeners (cpp/box ls)}))
    (cpp/wlr_seat_set_keyboard (cpp/unbox (:* wlr_seat) (:seat @state/wm))
                               wlr_keyboard)))

(defn keyboard-pred [k m]
  (cpp/== (cpp/unbox (:* wlr_keyboard) k)
          (cpp/unbox (:* wlr_keyboard) (:wlr-reference m))))

(defn keyboard-destroy [k]
  (println "keyboard destroy state is :" @(:keyboards @state/wm))
  (let [p (partial keyboard-pred k)
        state (first (filter p @(:keyboards @state/wm)))
        ]
    (cpp/cleanup_listeners (cpp/unbox (:* array_of_listeners) (:listeners state)))
    (swap! (:keyboards @state/wm)
           (fn [v] (vec (remove p v))))))

(defn new-pointer [d]
  (cpp/wlr_cursor_attach_input_device 
    (cpp/unbox (:* wlr_cursor) (:cursor @state/wm))
    (cpp/unbox (:* wlr_input_device) d)))

(defn new-callback [d]
  (println "input new callback!!!!")
  (let [device (cpp/unbox (:* wlr_input_device) d)
        device-type (.-type device)
        ]
    (cond
      (= device-type cpp/WLR_INPUT_DEVICE_KEYBOARD) (new-keyboard d)
      (= device-type cpp/WLR_INPUT_DEVICE_POINTER)  (new-pointer d)
      (true) (do
               (println "------- UNKNOWN DEVICE")))))
