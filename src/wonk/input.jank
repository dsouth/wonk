(ns wonk.input
  (:require [wonk.state :as state])
  (:include "extern.hpp"
            "callbacks.h"
            "xkbcommon/xkbcommon-keysyms.h"
            "xkbcommon/xkbcommon.h"))

(defn is-target-in-vec? [target array length index]
  (if (= length index)
    false
    (if (= target (aget array index))
      true
      (recur target array length (inc index)))))

;; for each map in the keyboard array, pass in the listeners arry and length
;; TODO better way to get the listeners?!?!
(defn get-keyboard-map [target m v]
  (if (nil? m)
    nil
    (let [listeners (cpp/unbox (:* listeners) (:listeners m))
          length (.-length listeners)
          array (.-listeners listeners)]
      (if (is-target-in-vec? target array length 0)
        m
        (let [head (first v)
              tail (rest v)]
          (recur target head tail))))))

(defn modifier-press [e]
  (let [event (cpp/unbox (:* wlr_keyboard_key_event) e)
        keycode (+ (.-keycode event) 8)
        syms (#cpp (:* xkb_keysym_t))]
    (println "modifier press!")))

(defn key-press-modal [event sym-size syms]
  (if (cpp/== (.-state (cpp/unbox (:* wlr_keyboard_key_event) event)) 
              cpp/WL_KEYBOARD_KEY_STATE_PRESSED)
    (loop [index 0]
      (case (aget syms index)
        cpp/XKB_KEY_Esacpe (cpp/wl_display_terminate 
                             (cpp/unbox (:* wl_display) (:display @state/wm)))
        true)
      (if (< sym-size index)
        (recur (inc index))))))

(defn key-press [e l]
  (let [event (cpp/unbox (:* wlr_keyboard_key_event) e)        
        keycode (+ (.-keycode event) 8)
        syms (#cpp (:* (:const xkb_keysym_t)))
        keyboard-state-list @(:keyboards @state/wm)
        keyboard-state (get-keyboard-map 
                         (cpp/unbox (:* wl_listener) l)
                         (first keyboard-state-list)
                         (rest keyboard-state-list))
        ]
    (if (not (nil? keyboard-state))
      (let [wlr-keyboard (cpp/unbox (:* wlr_keyboard) (:wlr-reference keyboard-state))
            xkb-state (cpp/unbox (:* xkb_state) (:* (.-xkb_state wlr-keyboard)))
            sym-size (cpp/xkb_state_key_get_syms 
                       xkb-state
                       keycode 
                       (cpp/& syms))
            ]
      (key-press-modal [e sym-size (cpp/box syms)])))
    (println "key press!")))

(defn new-keyboard [d]
  (let [device (cpp/unbox (:* wlr_input_device) d)
        wlr_keyboard (cpp/wlr_keyboard_from_input_device device)
        context (cpp/xkb_context_new cpp/XKB_CONTEXT_NO_FLAGS)
        keymap (cpp/xkb_keymap_new_from_names 
                 context cpp/nullptr cpp/XKB_KEYMAP_COMPILE_NO_FLAGS)
        ]
    (if (not (cpp/wlr_keyboard_set_keymap wlr_keyboard keymap))
      ;; should log error here TODO hook up wlr logging
      (println "FAILED to set keymap"))
    (cpp/xkb_keymap_unref keymap)
    (cpp/xkb_context_unref context)
    (let [rate-hz 25
          delay-ms 600]
      (cpp/wlr_keyboard_set_repeat_info wlr_keyboard rate-hz delay-ms))
    (let [listeners (cpp/wire_keyboard_listeners device wlr_keyboard)]
      (swap! (:keyboards @state/wm) conj {:wlr-reference (cpp/box wlr_keyboard)
                                          :listeners (cpp/box listeners)}))
    (cpp/wlr_seat_set_keyboard (cpp/unbox (:* wlr_seat) (:seat @state/wm))
                               wlr_keyboard)))

(defn keyboard-destroy [k]
  (let [keyboard (cpp/unbox (:* wlr_keyboard) k)
        state (first
                (filter
                  #(cpp/== keyboard (cpp/unbox (:* wlr_keyboard) (:wlr-reference %)))
                  @(:keyboards @state/wm)))
                  ]
    (cpp/cleanup_listeners (cpp/unbox (:* listeners) (:listeners state)))
    (swap! (:keyboards @state/wm)
           (fn [v]
             (vec
               (remove
                 (fn [m]
                   #(cpp/== keyboard (cpp/unbox (:* wlr_keyboard) (:wlr-reference m))))
                 v))))))


(defn new-pointer [d]
  (println "setting up new pointer"))

(defn new-callback [d]
  (println "input new callback!!!!")
  (let [device (cpp/unbox (:* wlr_input_device) d)
        type (.-type device)
        ]
    (cond
      (= type cpp/WLR_INPUT_DEVICE_KEYBOARD) (new-keyboard d)
      (= type cpp/WLR_INPUT_DEVICE_POINTER)  (new-pointer d)
      (true) (do
               (println "------- UNKNOWN DEVICE")))))
